FROM python:3.11

# Install common CI tools
RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    awscli \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install Terraform
RUN wget -O /tmp/terraform.zip https://releases.hashicorp.com/terraform/1.9.8/terraform_1.9.8_linux_arm64.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin/ \
    && chmod +x /usr/local/bin/terraform \
    && rm /tmp/terraform.zip

# Default command
CMD ["python3"]